@model List<HrmSystem.Core.Entities.Project>
@{
    ViewData["Title"] = "Quản Lý Dự Án";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="fa-solid fa-diagram-project text-primary me-2"></i>Danh Sách Dự Án
        </h3>
        <p class="text-muted small mb-0">Collection <code>projects</code> chứa mảng Embedded Documents: <code>members</code> (nhân viên tham gia) và <code>milestones</code> (cột mốc dự án)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="fa-solid fa-plus me-1"></i> Tạo Dự Án Mới
    </a>
</div>

<div class="row g-4 mb-4">
    @foreach (var proj in Model)
    {
        <div class="col-lg-6">
            <div class="card-hrm h-100">
                <div class="card-hrm-header">
                    <div>
                        <span class="code-badge me-2">@proj.Code</span>
                        <h5 class="d-inline fw-bold text-dark">@proj.Name</h5>
                    </div>
                    @switch (proj.Status)
                    {
                        case "Active":
                            <span class="badge bg-success">Đang thực hiện (Active)</span>
                            break;
                        case "Completed":
                            <span class="badge bg-primary">Đã hoàn thành</span>
                            break;
                        case "Planning":
                            <span class="badge bg-warning text-dark">Lập kế hoạch</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@proj.Status</span>
                            break;
                    }
                </div>
                <div class="card-hrm-body">
                    <p class="text-muted small mb-3">@proj.Description</p>

                    <div class="d-flex justify-content-between small py-2 border-bottom">
                        <span class="text-muted"><i class="fa-solid fa-building me-1"></i>Phòng ban:</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(proj.DepartmentName) ? "Chưa xếp" : proj.DepartmentName)</strong>
                    </div>

                    <div class="d-flex justify-content-between small py-2 border-bottom">
                        <span class="text-muted"><i class="fa-solid fa-calendar me-1"></i>Thời gian:</span>
                        <span>@proj.StartDate.ToString("dd/MM/yyyy") - @(proj.EndDate.HasValue ? proj.EndDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</span>
                    </div>

                    <div class="d-flex justify-content-between small py-2 border-bottom">
                        <span class="text-muted"><i class="fa-solid fa-money-bill-wave me-1 text-success"></i>Ngân sách:</span>
                        <strong class="text-success fs-6">@proj.Budget.ToString("N0") đ</strong>
                    </div>

                    <!-- Mảng Members & Milestones Summary -->
                    <div class="row g-2 pt-3 mb-3">
                        <div class="col-6">
                            <div class="p-2 bg-light rounded border text-center">
                                <small class="text-muted d-block">Thành viên (Array)</small>
                                <span class="fw-bold text-primary fs-5">@proj.Members.Count</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 bg-light rounded border text-center">
                                <small class="text-muted d-block">Cột mốc đã xong</small>
                                <span class="fw-bold text-success fs-5">
                                    @proj.Milestones.Count(m => m.IsCompleted) / @proj.Milestones.Count
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@proj.Id" class="btn btn-sm btn-outline-info">
                            <i class="fa-solid fa-users me-1"></i> Chi tiết & Phân công
                        </a>
                        <a asp-action="Edit" asp-route-id="@proj.Id" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@proj.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn chắc chắn muốn xóa dự án @proj.Name?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
