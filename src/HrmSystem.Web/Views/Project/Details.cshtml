@model HrmSystem.Core.Entities.Project
@{
    ViewData["Title"] = "Chi Tiết Dự Án - " + Model.Name;
    var availableEmployees = ViewBag.AvailableEmployees as List<HrmSystem.Core.Entities.Employee> ?? new List<HrmSystem.Core.Entities.Employee>();
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="code-badge fs-6">@Model.Code</span>
            <h3 class="fw-bold mb-0">@Model.Name</h3>
        </div>
        <p class="text-muted small mb-0">Quản lý mảng lồng nhau (Embedded Arrays): Thành viên dự án (<code>members</code>) và Cột mốc (<code>milestones</code>)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fa-solid fa-pen me-1"></i> Sửa dự án
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Project Overview -->
    <div class="col-lg-4">
        <div class="card-hrm p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i>Tổng Quan Dự Án</h5>
            <p class="text-muted small mb-3">@Model.Description</p>

            <ul class="list-unstyled small mb-0">
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Phòng ban phụ trách:</span>
                    <strong class="text-dark">@(string.IsNullOrEmpty(Model.DepartmentName) ? "Chưa xếp" : Model.DepartmentName)</strong>
                </li>
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Ngân sách:</span>
                    <strong class="text-success fs-6">@Model.Budget.ToString("N0") đ</strong>
                </li>
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Ngày bắt đầu:</span>
                    <span>@Model.StartDate.ToString("dd/MM/yyyy")</span>
                </li>
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Hạn hoàn thành:</span>
                    <span>@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "Chưa ấn định")</span>
                </li>
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Trạng thái:</span>
                    <span class="badge @(Model.Status == "Active" ? "bg-success" : Model.Status == "Completed" ? "bg-primary" : "bg-warning text-dark")">@Model.Status</span>
                </li>
                <li class="d-flex justify-content-between py-2">
                    <span class="text-muted">Số thành viên:</span>
                    <strong class="text-primary">@Model.Members.Count người</strong>
                </li>
            </ul>
        </div>

        <!-- Form Thêm Cột Mốc Dự Án (Push vào mảng milestones) -->
        <div class="card-hrm">
            <div class="card-hrm-header">
                <h6 class="card-hrm-title fs-6">
                    <i class="fa-solid fa-flag-checkered text-warning"></i>
                    Thêm Cột Mốc (<code>milestones</code> Array)
                </h6>
            </div>
            <div class="card-hrm-body">
                <form asp-action="AddMilestone" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên cột mốc</label>
                        <input type="text" name="title" required class="form-control form-control-sm" placeholder="VD: Hoàn thành kiểm thử Alpha..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Hạn chót</label>
                        <input type="date" name="dueDate" required class="form-control form-control-sm" value="@DateTime.UtcNow.AddMonths(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-warning text-dark w-100 fw-bold">
                        <i class="fa-solid fa-plus me-1"></i> Thêm Cột Mốc
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Members & Milestones Tables -->
    <div class="col-lg-8">
        <!-- Section 1: Mảng Members (Embedded Documents in Array) -->
        <div class="card-hrm mb-4">
            <div class="card-hrm-header">
                <h5 class="card-hrm-title">
                    <i class="fa-solid fa-users text-primary"></i>
                    Mảng Thành Viên Dự Án (<code>members</code>)
                </h5>
                <button type="button" class="btn btn-sm btn-primary-custom" data-bs-toggle="modal" data-bs-target="#assignMemberModal">
                    <i class="fa-solid fa-user-plus me-1"></i> Phân Công Nhân Sự
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hrm">
                    <thead>
                        <tr>
                            <th>Mã NV</th>
                            <th>Họ & Tên</th>
                            <th>Vai Trò Trong Dự Án</th>
                            <th class="text-center">Số Giờ/Tuần</th>
                            <th>Ngày Tham Gia</th>
                            <th class="text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Members.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">
                                    Dự án chưa có nhân sự nào được phân công. Hãy nhấn "Phân Công Nhân Sự" để thêm!
                                </td>
                            </tr>
                        }
                        @foreach (var m in Model.Members)
                        {
                            <tr>
                                <td><span class="code-badge">@m.EmployeeCode</span></td>
                                <td class="fw-bold text-dark">
                                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@m.EmployeeId" class="text-dark text-decoration-none">
                                        @m.FullName
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border">@m.Role</span>
                                </td>
                                <td class="text-center fw-semibold">@m.AllocatedHoursPerWeek giờ/tuần</td>
                                <td>@m.JoinedDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <form asp-action="RemoveMember" method="post" class="d-inline" onsubmit="return confirm('Loại nhân viên @m.FullName khỏi dự án?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.Id" />
                                        <input type="hidden" name="employeeId" value="@m.EmployeeId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa khỏi mảng members ($pull)">
                                            <i class="fa-solid fa-user-minus"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: Mảng Cột Mốc (Milestones) -->
        <div class="card-hrm">
            <div class="card-hrm-header">
                <h5 class="card-hrm-title">
                    <i class="fa-solid fa-list-check text-success"></i>
                    Tiến Độ Cột Mốc Dự Án (<code>milestones</code>)
                </h5>
                <span class="badge bg-success-subtle text-success border">
                    @Model.Milestones.Count(m => m.IsCompleted) / @Model.Milestones.Count Hoàn thành
                </span>
            </div>
            <div class="card-hrm-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.Milestones.Count == 0)
                    {
                        <li class="list-group-item text-center py-4 text-muted small">
                            Chưa có cột mốc nào được tạo.
                        </li>
                    }
                    @foreach (var ms in Model.Milestones)
                    {
                        <li class="list-group-item d-flex align-items-center justify-content-between p-3">
                            <div class="d-flex align-items-center gap-3">
                                <input type="checkbox" class="form-check-input mt-0 fs-5" 
                                       checked="@ms.IsCompleted" 
                                       onchange="toggleMilestone('@Model.Id', '@ms.Title', this.checked)" />
                                <div>
                                    <span class="fw-bold @(ms.IsCompleted ? "text-decoration-line-through text-muted" : "text-dark")">
                                        @ms.Title
                                    </span>
                                    <small class="text-muted d-block">
                                        <i class="fa-solid fa-calendar me-1"></i>Hạn chót: @ms.DueDate.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>
                            <span class="badge @(ms.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                @(ms.IsCompleted ? "Đã xong" : "Chưa hoàn thành")
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal Phân Công Nhân Sự Vào Mảng Members -->
<div class="modal fade" id="assignMemberModal" tabindex="-1" aria-labelledby="assignMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddMember" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="assignMemberModalLabel">
                        <i class="fa-solid fa-user-plus text-primary me-2"></i>Phân Công Nhân Sự Vào Dự Án
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Thêm nhân viên vào mảng <code>members</code> của dự án trong MongoDB (Atomic $push).</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn Nhân Viên</label> <span class="text-danger">*</span>
                        <select name="employeeId" required class="form-select">
                            <option value="">-- Chọn nhân viên có sẵn --</option>
                            @foreach (var emp in availableEmployees)
                            {
                                <option value="@emp.Id">@emp.FullName (@emp.EmployeeCode) - @emp.Position</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai Trò Trong Dự Án</label> <span class="text-danger">*</span>
                        <select name="role" required class="form-select">
                            <option value="Project Manager">Project Manager (Quản lý dự án)</option>
                            <option value="Tech Lead">Tech Lead (Trưởng nhóm kỹ thuật)</option>
                            <option value="Backend Developer">Backend Developer</option>
                            <option value="Frontend Developer">Frontend Developer</option>
                            <option value="DevOps Engineer">DevOps & Cloud Engineer</option>
                            <option value="QA / Tester">QA / Tester</option>
                            <option value="Business Analyst">Business Analyst</option>
                            <option value="Consultant">Chuyên viên cố vấn</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số Giờ Phân Bổ / Tuần</label>
                        <input type="number" name="hours" min="1" max="60" value="40" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="fa-solid fa-check me-1"></i> Lưu Phân Công
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleMilestone(projectId, title, isCompleted) {
        fetch(`/Project/ToggleMilestone?projectId=${projectId}&title=${encodeURIComponent(title)}&isCompleted=${isCompleted}`, {
            method: 'POST'
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                Swal.fire('Lỗi', 'Không thể cập nhật trạng thái cột mốc', 'error');
            }
        });
    }
</script>
}
