@model HrmSystem.Core.Entities.Department
@{
    ViewData["Title"] = "Thêm Phòng Ban Mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0">Thêm Mới Phòng Ban</h3>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>

        <div class="card-hrm">
            <div class="card-hrm-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Code" class="form-control" placeholder="VD: PB05" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Name" class="form-control" placeholder="Tên phòng ban" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Chức năng, nhiệm vụ phòng ban..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Budget" class="form-label fw-semibold"></label>
                            <input asp-for="Budget" class="form-control" type="number" step="1000000" placeholder="500000000" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label fw-semibold"></label>
                            <input asp-for="ContactEmail" class="form-control" placeholder="email@congty.com" />
                        </div>
                    </div>

                    <!-- Embedded Document: Location -->
                    <div class="p-3 bg-light rounded border mb-4">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="fa-solid fa-map-pin me-1"></i> Embedded Document: Vị Trí Làm Việc (<code>location</code>)
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Location.Building" class="form-label small fw-semibold"></label>
                                <input asp-for="Location.Building" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Location.Floor" class="form-label small fw-semibold"></label>
                                <input asp-for="Location.Floor" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Location.RoomNumber" class="form-label small fw-semibold"></label>
                                <input asp-for="Location.RoomNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Location.City" class="form-label small fw-semibold"></label>
                                <input asp-for="Location.City" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary-custom px-4">Lưu Phòng Ban</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
