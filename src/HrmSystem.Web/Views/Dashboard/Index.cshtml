@model HrmSystem.Core.Dtos.DashboardOverviewDto
@{
    ViewData["Title"] = "Dashboard Thống Kê Tương Tác - MongoDB Aggregation";
    var providerInfo = ViewBag.ProviderInfo as HrmSystem.Infrastructure.IDatabaseProviderInfo;
    var indexes = ViewBag.Indexes as List<HrmSystem.Infrastructure.Configuration.CollectionIndexInfo> ?? new List<HrmSystem.Infrastructure.Configuration.CollectionIndexInfo>();
}

<!-- Provider & Architecture Hero Banner (Flat Chocolate Theme) -->
<div class="provider-banner">
    <div>
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <span class="provider-tag"><i class="fa-solid fa-leaf me-1"></i> Active: @(providerInfo?.CurrentProvider ?? "MongoDB")</span>
            <span class="badge" style="background: #C9A47E; color: #4A3428; font-weight: 600;">DB: @(providerInfo?.DatabaseName ?? "HrmDb_PhamThanhHuy_2001230304")</span>
            <span class="badge" style="background: #A9C9E8; color: #1A4C73; font-weight: 600;">3 Collections: departments | employees | projects</span>
        </div>
        <h4 class="mb-1 fw-bold" style="color: #FBF3EA;">Hệ Thống Quản Lý Nhân Sự Doanh Nghiệp (HRM NoSQL)</h4>
        <p class="mb-0 small" style="color: #E5D5C8;">
            Phát triển theo <strong>Repository Pattern</strong> (Core Interfaces ⟷ MongoDB Infrastructure). Sẵn sàng chuyển đổi provider sang Cassandra, Neo4j, Redis mà không cần sửa Controller.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="#indexes-section" class="btn btn-sm" style="background: #F3D2A0; color: #754807; font-weight: 600; border: none;">
            <i class="fa-solid fa-bolt me-1"></i> Xem Indexes (@indexes.Count)
        </a>
        <a href="#pipeline-section" class="btn btn-sm" style="background: #BEE7D8; color: #195842; font-weight: 600; border: none;">
            <i class="fa-solid fa-filter me-1"></i> Aggregation Pipeline
        </a>
    </div>
</div>

<!-- 4 Stat KPI Cards (Nền trắng, Bo góc 18px, Viền trên 6px màu kẹo riêng biệt, Icon nền đặc) -->
<div class="row g-4 mb-4">
    <!-- Thẻ 1: Tổng Nhân Sự (Hồng dâu #F6B8C7) -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card kpi-strawberry">
            <div class="kpi-header">
                <p class="kpi-title">Tổng Nhân Sự</p>
                <div class="kpi-icon-badge"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="kpi-value">@Model.TotalEmployees</div>
            <div class="kpi-subtitle">
                <i class="fa-solid fa-circle-check me-1" style="color: #195842;"></i> @Model.ActiveEmployees Đang hoạt động
            </div>
        </div>
    </div>

    <!-- Thẻ 2: Phòng Ban (Bạc hà #BEE7D8) -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card kpi-mint">
            <div class="kpi-header">
                <p class="kpi-title">Phòng Ban</p>
                <div class="kpi-icon-badge"><i class="fa-solid fa-building"></i></div>
            </div>
            <div class="kpi-value">@Model.TotalDepartments</div>
            <div class="kpi-subtitle">
                <i class="fa-solid fa-layer-group me-1" style="color: #195842;"></i> Embedded Location doc
            </div>
        </div>
    </div>

    <!-- Thẻ 3: Dự Án Đang Chạy (Caramel #F3D2A0) -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card kpi-caramel">
            <div class="kpi-header">
                <p class="kpi-title">Dự Án Đang Chạy</p>
                <div class="kpi-icon-badge"><i class="fa-solid fa-diagram-project"></i></div>
            </div>
            <div class="kpi-value">@Model.ActiveProjects <small class="fs-6 fw-normal" style="color: #826E61;">/ @Model.TotalProjects</small></div>
            <div class="kpi-subtitle">
                <i class="fa-solid fa-people-roof me-1" style="color: #754807;"></i> Mảng phân công thành viên
            </div>
        </div>
    </div>

    <!-- Thẻ 4: Quỹ Lương (Socola sữa #C9A47E) -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card kpi-milkchocolate">
            <div class="kpi-header">
                <p class="kpi-title">Quỹ Lương Tháng</p>
                <div class="kpi-icon-badge"><i class="fa-solid fa-money-bill-wave"></i></div>
            </div>
            <div class="kpi-value" style="font-size: 1.55rem;">@Model.TotalMonthlyPayroll.ToString("N0") <small class="fs-6" style="color: #826E61;">đ</small></div>
            <div class="kpi-subtitle">
                <i class="fa-solid fa-calculator me-1" style="color: #4A3428;"></i> TB: @Model.AverageSalary.ToString("N0") đ/người
            </div>
        </div>
    </div>
</div>

<!-- 4 Interactive Charts Section (Chart.js Palette Pastel) -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Headcount & Average Salary by Department (Bar + Line) -->
    <div class="col-lg-8">
        <div class="card-hrm h-100">
            <div class="card-hrm-header">
                <h5 class="card-hrm-title">
                    <i class="fa-solid fa-chart-column" style="color: #C9A47E;"></i>
                    Nhân Sự & Mức Lương Trung Bình Theo Phòng Ban
                </h5>
                <span class="badge" style="background: #F3D2A0; color: #754807; border: 1px solid #E6C48F;">MongoDB $group Pipeline</span>
            </div>
            <div class="card-hrm-body">
                <div style="height: 320px; position: relative;">
                    <canvas id="deptSalaryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Top Skills Distribution (Hỗ trợ chuyển đổi Radar / Cột) -->
    <div class="col-lg-4">
        <div class="card-hrm h-100">
            <div class="card-hrm-header">
                <h5 class="card-hrm-title">
                    <i class="fa-solid fa-lightbulb" style="color: #F3D2A0;"></i>
                    Top Kỹ Năng Doanh Nghiệp
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-sm btn-outline-chocolate active" id="btnChartRadar" onclick="switchSkillChart('radar')">Radar</button>
                        <button type="button" class="btn btn-sm btn-outline-chocolate" id="btnChartBar" onclick="switchSkillChart('bar')">Cột</button>
                    </div>
                    <span class="badge d-none d-sm-inline-block" style="background: #BEE7D8; color: #195842;">$unwind</span>
                </div>
            </div>
            <div class="card-hrm-body">
                <div style="height: 320px; position: relative;">
                    <canvas id="skillsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 3: Project Status Distribution (Donut Pastel) -->
    <div class="col-lg-5">
        <div class="card-hrm h-100">
            <div class="card-hrm-header">
                <h5 class="card-hrm-title">
                    <i class="fa-solid fa-pie-chart" style="color: #BEE7D8;"></i>
                    Tỷ Lệ Trạng Thái Dự Án
                </h5>
                <span class="badge" style="background: #BEE7D8; color: #195842; border: 1px solid #A6DAC8;">Projects Collection</span>
            </div>
            <div class="card-hrm-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="projectStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 4: Salary Distribution by Position (Cột Pastel) -->
    <div class="col-lg-7">
        <div class="card-hrm h-100">
            <div class="card-hrm-header">
                <h5 class="card-hrm-title">
                    <i class="fa-solid fa-ranking-star" style="color: #D9A9E8;"></i>
                    Mức Lương Bình Quân Theo Chức Vụ
                </h5>
                <span class="badge" style="background: #A9C9E8; color: #1A4C73; border: 1px solid #96BDDE;">Position Aggregation</span>
            </div>
            <div class="card-hrm-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="positionSalaryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Department Statistics Table -->
<div class="card-hrm mb-4">
    <div class="card-hrm-header">
        <h5 class="card-hrm-title">
            <i class="fa-solid fa-table-list" style="color: #4A3428;"></i>
            Chi Tiết Thống Kê Phòng Ban (Tổng Hợp Từ Aggregation)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hrm">
            <thead>
                <tr>
                    <th>Phòng Ban</th>
                    <th class="text-center">Số Nhân Viên</th>
                    <th class="text-end">Lương TB (VNĐ)</th>
                    <th class="text-end">Lương Thấp Nhất</th>
                    <th class="text-end">Lương Cao Nhất</th>
                    <th class="text-end">Tổng Quỹ Lương</th>
                    <th class="text-end">Ngân Sách Phòng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model.DepartmentStats)
                {
                    <tr>
                        <td class="fw-bold" style="color: #4A3428;">
                            <i class="fa-solid fa-building me-2" style="color: #C9A47E;"></i> @dept.DepartmentName
                        </td>
                        <td class="text-center">
                            <span class="badge px-3 py-2 rounded-pill" style="background: #F3D2A0; color: #754807; font-weight: 700;">@dept.EmployeeCount NV</span>
                        </td>
                        <td class="text-end fw-semibold" style="color: #4A3428;">@dept.AverageSalary.ToString("N0") đ</td>
                        <td class="text-end" style="color: #826E61;">@dept.MinSalary.ToString("N0") đ</td>
                        <td class="text-end fw-semibold" style="color: #195842;">@dept.MaxSalary.ToString("N0") đ</td>
                        <td class="text-end fw-bold" style="color: #4A3428;">@dept.TotalSalary.ToString("N0") đ</td>
                        <td class="text-end" style="color: #826E61;">@dept.Budget.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Aggregation Pipeline Showcase Section -->
<div class="card-hrm mb-4" id="pipeline-section">
    <div class="card-hrm-header" style="background: #4A3428; color: #FBF3EA;">
        <h5 class="card-hrm-title" style="color: #FBF3EA;">
            <i class="fa-solid fa-terminal" style="color: #BEE7D8;"></i>
            Minh Chứng Aggregation Pipeline MongoDB Trong Hệ Thống
        </h5>
        <span class="badge" style="background: #BEE7D8; color: #195842; font-weight: 600;">Chuẩn BSON Syntax</span>
    </div>
    <div class="card-hrm-body">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-3 rounded border" style="background: #FFF9F3; border-color: #EBDCCE !important;">
                    <h6 class="fw-bold mb-2" style="color: #4A3428;">
                        <i class="fa-solid fa-code me-1" style="color: #C9A47E;"></i> Pipeline 1: Thống Kê Nhân Sự & Quỹ Lương Phòng Ban
                    </h6>
                    <p class="small mb-2" style="color: #826E61;">Sử dụng <code>$group</code> với các accumulator: <code>$sum</code>, <code>$avg</code>, <code>$min</code>, <code>$max</code></p>
                    <pre class="p-3 rounded small mb-0" style="background: #362419; color: #F3D2A0; max-height: 180px; overflow-y: auto; border: 1px solid #4A3428;"><code>[
  { "$group": {
      "_id": { 
        "departmentId": "$departmentId", 
        "departmentName": "$departmentName" 
      },
      "employeeCount": { "$sum": 1 },
      "averageSalary": { "$avg": "$salary" },
      "minSalary": { "$min": "$salary" },
      "maxSalary": { "$max": "$salary" },
      "totalSalary": { "$sum": "$salary" }
  }},
  { "$sort": { "employeeCount": -1 } }
]</code></pre>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 rounded border" style="background: #FFF9F3; border-color: #EBDCCE !important;">
                    <h6 class="fw-bold mb-2" style="color: #4A3428;">
                        <i class="fa-solid fa-code me-1" style="color: #F3D2A0;"></i> Pipeline 2: Phân Tích Mảng Kỹ Năng Doanh Nghiệp
                    </h6>
                    <p class="small mb-2" style="color: #826E61;">Tách phần tử mảng bằng <code>$unwind</code> rồi gom nhóm với <code>$group</code> và <code>$limit</code></p>
                    <pre class="p-3 rounded small mb-0" style="background: #362419; color: #F3D2A0; max-height: 180px; overflow-y: auto; border: 1px solid #4A3428;"><code>[
  { "$unwind": "$skills" },
  { "$group": {
      "_id": "$skills",
      "count": { "$sum": 1 }
  }},
  { "$sort": { "count": -1 } },
  { "$limit": 10 }
]</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MongoDB Indexes Verification Table -->
<div class="card-hrm mb-4" id="indexes-section">
    <div class="card-hrm-header">
        <h5 class="card-hrm-title">
            <i class="fa-solid fa-bolt" style="color: #F3D2A0;"></i>
            Danh Sách MongoDB Indexes Đang Hoạt Động Theo Đặc Tả
        </h5>
        <span class="badge" style="background: #F3D2A0; color: #754807; border: 1px solid #E6C48F;">Unique, Compound, Multikey, Text Search</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hrm">
            <thead>
                <tr>
                    <th>Collection</th>
                    <th>Tên Index</th>
                    <th>Khóa (Keys / Fields)</th>
                    <th>Loại Index</th>
                    <th class="text-center">Unique?</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var idx in indexes)
                {
                    <tr>
                        <td>
                            <span class="badge" style="background: #4A3428; color: #FBF3EA;">@idx.CollectionName</span>
                        </td>
                        <td class="fw-bold" style="color: #4A3428;">@idx.IndexName</td>
                        <td>
                            <span class="code-badge">@idx.Keys</span>
                        </td>
                        <td>
                            @if (idx.IsUnique)
                            {
                                <span class="badge-status-terminated">Unique Index</span>
                            }
                            else if (idx.IndexName.Contains("compound"))
                            {
                                <span class="badge-status-onleave">Compound Index</span>
                            }
                            else if (idx.IndexName.Contains("multikey"))
                            {
                                <span class="badge-status-probation">Multikey Index (Array)</span>
                            }
                            else if (idx.IndexName.Contains("text"))
                            {
                                <span class="badge-status-active">Full-Text Search Index</span>
                            }
                            else
                            {
                                <span class="badge" style="background: #EBDCCE; color: #4A3428;">Single Field Index</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (idx.IsUnique)
                            {
                                <i class="fa-solid fa-circle-check" style="color: #195842; font-size: 1.15rem;"></i>
                            }
                            else
                            {
                                <span style="color: #826E61;">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // Global Chart.js configuration for Chocolate Candy Theme
    Chart.defaults.font.family = "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif";
    Chart.defaults.color = '#4A3428';

    // Pastel Candy Palette (#F6B8C7, #BEE7D8, #F3D2A0, #C9A47E, #D9A9E8, #A9C9E8)
    const pastelPalette = ['#F6B8C7', '#BEE7D8', '#F3D2A0', '#C9A47E', '#D9A9E8', '#A9C9E8'];

    // Dữ liệu từ Model Razor
    const deptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentStats.Select(d => d.DepartmentName)));
    const deptHeadcounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentStats.Select(d => d.EmployeeCount)));
    const deptAvgSalaries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentStats.Select(d => d.AverageSalary)));

    const skillLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSkills.Select(s => s.Skill)));
    const skillCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSkills.Select(s => s.Count)));

    const projectLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectStats.Select(p => p.Status)));
    const projectCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectStats.Select(p => p.Count)));

    const positionLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PositionStats.Select(p => p.Position)));
    const positionSalaries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PositionStats.Select(p => p.AverageSalary)));

    // 1. Chart Phòng Ban: Nhân sự & Lương TB (Biểu đồ Cột kết hợp Đường)
    const ctxDept = document.getElementById('deptSalaryChart').getContext('2d');
    new Chart(ctxDept, {
        type: 'bar',
        data: {
            labels: deptLabels,
            datasets: [
                {
                    label: 'Số Nhân Sự (người)',
                    data: deptHeadcounts,
                    backgroundColor: '#F6B8C7', // Hồng dâu
                    borderColor: '#F6B8C7',
                    borderWidth: 1,
                    borderRadius: 8,
                    yAxisID: 'y'
                },
                {
                    label: 'Lương Trung Bình (VNĐ)',
                    data: deptAvgSalaries,
                    type: 'line',
                    borderColor: '#4A3428', // Nâu socola
                    backgroundColor: '#4A3428',
                    pointBackgroundColor: '#F3D2A0', // Caramel
                    pointBorderColor: '#4A3428',
                    pointBorderWidth: 2,
                    pointRadius: 6,
                    borderWidth: 3,
                    tension: 0.25,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    title: { display: true, text: 'Nhân sự (Người)', color: '#7D685B', font: { weight: '600' } },
                    grid: { color: '#F0E5DA' },
                    ticks: { stepSize: 1, color: '#7D685B' }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    title: { display: true, text: 'Lương TB (VNĐ)', color: '#7D685B', font: { weight: '600' } },
                    grid: { drawOnChartArea: false },
                    ticks: {
                        color: '#7D685B',
                        callback: function(val) { return (val / 1000000) + 'M'; }
                    }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#4A3428', font: { weight: '600' } }
                }
            }
        }
    });

    // 2. Chart Top Kỹ Năng (Hỗ trợ Radar và Cột với palette pastel)
    let currentSkillChart = null;
    function renderSkillChart(chartType) {
        if (currentSkillChart) {
            currentSkillChart.destroy();
        }
        const ctxSkills = document.getElementById('skillsChart').getContext('2d');

        if (chartType === 'radar') {
            currentSkillChart = new Chart(ctxSkills, {
                type: 'radar',
                data: {
                    labels: skillLabels,
                    datasets: [{
                        label: 'Số nhân viên nắm giữ',
                        data: skillCounts,
                        backgroundColor: 'rgba(217, 169, 232, 0.45)', // Pastel Lavender (#D9A9E8)
                        borderColor: '#C9A47E', // Milk chocolate (#C9A47E)
                        borderWidth: 2,
                        pointBackgroundColor: '#F6B8C7', // Hồng dâu (#F6B8C7)
                        pointBorderColor: '#4A3428',
                        pointHoverBackgroundColor: '#BEE7D8', // Bạc hà (#BEE7D8)
                        pointHoverBorderColor: '#4A3428',
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        r: {
                            angleLines: { color: '#EBDCCE' },
                            grid: { color: '#EBDCCE' },
                            pointLabels: {
                                color: '#4A3428',
                                font: { size: 11, weight: '600' }
                            },
                            ticks: {
                                color: '#826E61',
                                backdropColor: 'transparent',
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        } else {
            // Dạng biểu đồ cột ngang
            currentSkillChart = new Chart(ctxSkills, {
                type: 'bar',
                data: {
                    labels: skillLabels,
                    datasets: [{
                        label: 'Số nhân viên nắm giữ',
                        data: skillCounts,
                        backgroundColor: skillLabels.map((_, i) => pastelPalette[i % pastelPalette.length]),
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            ticks: { stepSize: 1, color: '#7D685B' },
                            grid: { color: '#F0E5DA' }
                        },
                        y: {
                            ticks: { color: '#4A3428', font: { weight: '600' } },
                            grid: { display: false }
                        }
                    }
                }
            });
        }
    }

    function switchSkillChart(type) {
        document.getElementById('btnChartRadar').classList.toggle('active', type === 'radar');
        document.getElementById('btnChartBar').classList.toggle('active', type === 'bar');
        renderSkillChart(type);
    }

    // Khởi tạo chart kỹ năng dạng Radar
    renderSkillChart('radar');

    // 3. Chart Trạng Thái Dự Án (Biểu đồ Donut Pastel phẳng, không gradient)
    const ctxProject = document.getElementById('projectStatusChart').getContext('2d');
    new Chart(ctxProject, {
        type: 'doughnut',
        data: {
            labels: projectLabels.map(s => s === 'Active' ? 'Đang chạy (Active)' : s === 'Completed' ? 'Hoàn thành' : s === 'Planning' ? 'Lập kế hoạch' : s),
            datasets: [{
                data: projectCounts,
                backgroundColor: ['#BEE7D8', '#F6B8C7', '#F3D2A0', '#C9A47E', '#D9A9E8'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#4A3428',
                        font: { weight: '600', size: 12 },
                        boxWidth: 14,
                        padding: 14
                    }
                }
            }
        }
    });

    // 4. Chart Thu Nhập Theo Chức Vụ (Biểu đồ Cột Pastel)
    const ctxPosition = document.getElementById('positionSalaryChart').getContext('2d');
    new Chart(ctxPosition, {
        type: 'bar',
        data: {
            labels: positionLabels,
            datasets: [{
                label: 'Mức Lương (VNĐ)',
                data: positionSalaries,
                backgroundColor: positionLabels.map((_, i) => pastelPalette[i % pastelPalette.length]),
                borderColor: positionLabels.map((_, i) => pastelPalette[i % pastelPalette.length]),
                borderWidth: 1,
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    grid: { color: '#F0E5DA' },
                    ticks: {
                        color: '#7D685B',
                        callback: function(val) { return (val / 1000000) + ' Tr'; }
                    }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#4A3428', font: { weight: '600' } }
                }
            }
        }
    });
</script>
}
